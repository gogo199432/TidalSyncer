# Copy to .env and fill in. .env is gitignored; this file is not.
#
#   cp .env.example .env
#
# Only the values that are secret or specific to you live here. Everything else is
# configured inline in docker-compose.yml.

# Your ListenBrainz username. "Created for you" playlists are public, so no token needed.
LISTENBRAINZ_USER=your-username

# Only for SYNC_FAVORITES below, which writes loved recordings to your account.
# From https://listenbrainz.org/settings/ — must belong to LISTENBRAINZ_USER above.
LISTENBRAINZ_TOKEN=

# From https://developer.tidal.com -> your app.
# Scopes: playlists.read, playlists.write (plus collection.read if you set
# TIDAL_SKIP_COLLECTION_FOR or SYNC_FAVORITES below).
# Redirect URI: http://localhost:8080/callback
TIDAL_CLIENT_ID=
TIDAL_CLIENT_SECRET=

# ISO 3166-1 alpha-2, matching your TIDAL account's country. Affects which tracks resolve.
TIDAL_COUNTRY_CODE=US

# Used for the daemon's cron schedule and log timestamps.
TZ=UTC

# Sent in the User-Agent to ListenBrainz, as their API guidelines ask for.
CONTACT_EMAIL=you@example.com

# Optional. Drop tracks already in your TIDAL collection, per playlist family;
# "*" for all, empty to disable. Enabling this requires the collection.read scope
# and one more `login`. See the README for why weekly-jams is a poor choice here.
TIDAL_SKIP_COLLECTION_FOR=
