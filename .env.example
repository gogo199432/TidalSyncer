# Copy to .env and fill in. .env is gitignored; this file is not.
#
#   cp .env.example .env
#
# Only the values that are secret or specific to you live here. Everything else is
# configured inline in docker-compose.yml.

# Your ListenBrainz username. "Created for you" playlists are public, so no token needed.
LISTENBRAINZ_USER=your-username

# Only for SYNC_FAVORITES below, which writes loved recordings to your account.
# From https://listenbrainz.org/settings/ — must belong to LISTENBRAINZ_USER above.
LISTENBRAINZ_TOKEN=

# From https://developer.tidal.com -> your app.
# Scopes: playlists.read, playlists.write (plus collection.read if you set
# TIDAL_SKIP_COLLECTION_FOR or SYNC_FAVORITES below).
# Redirect URI: http://localhost:8080/callback
TIDAL_CLIENT_ID=
TIDAL_CLIENT_SECRET=

# ISO 3166-1 alpha-2, matching your TIDAL account's country. Affects which tracks resolve.
TIDAL_COUNTRY_CODE=US

# Used for the daemon's cron schedule and log timestamps.
TZ=UTC

# Sent in the User-Agent to ListenBrainz, as their API guidelines ask for.
CONTACT_EMAIL=you@example.com

# Optional. Drop tracks already in your TIDAL collection, per playlist family;
# "*" for all, empty to disable. Enabling this requires the collection.read scope
# and one more `login`. See the README for why weekly-jams is a poor choice here.
TIDAL_SKIP_COLLECTION_FOR=

# --- Downloading (optional; `export` does not need any of this) -----------------
#
# The client id of a TIDAL player that supports the OAuth device flow. This is NOT
# your developer-portal client id above, and the two are not interchangeable: TIDAL
# rejects a developer-portal client on the device endpoint ("Client is not a Limited
# Input Device client"), and a developer-portal token only ever gets a 30-second
# preview manifest — `previewReason: FULL_REQUIRES_SUBSCRIPTION` — no matter whose
# subscription is behind it.
#
# Leave empty and `download` stays off; `export` works regardless.
# Read src/tidal/device-auth.ts before setting this: it uses a client id that is not
# yours to identify as, which is a terms-of-service matter and puts the account you
# authorise at some risk. `python-tidal` (the library SoulSync builds on) ships one
# openly if you want to see a working value.
TIDAL_DEVICE_CLIENT_ID=
TIDAL_DEVICE_CLIENT_SECRET=

# Replace library files TIDAL has a better copy of, rather than skipping them — the way a
# library of AAC rips becomes lossless. Off by default: it is the only mode that rewrites
# files you already have. `download --upgrade` turns it on for one run.
#
# What each attempt actually got is recorded in DATA_DIR/upgrades.json, because TIDAL's
# media tags describe the catalogue rather than your subscription: without it, a `hires`
# run on an account without the hi-res tier re-fetches the same 16-bit FLAC for ever.
TIDAL_UPGRADE=false

# Where an upgrade puts the file it replaced (default DATA_DIR/replaced); empty deletes it.
# Replacing most of a library retires most of a library — several gigabytes — so point this
# somewhere with room, and not at a small state volume. It must be outside LIBRARY_DIR, or
# your music server would index the replaced file alongside the one that replaced it.
TIDAL_REPLACED_DIR=

# How long a replaced file is kept there before a download deletes it. Every file gets the
# same window from the moment it was replaced. 0 keeps them for ever, to prune by hand.
TIDAL_REPLACED_RETENTION_DAYS=7
